# Copy to .env and adjust as needed.

# Postgres connection used by both the FastAPI app and the ingestion CLI.
# Note: mapped to host port 5433 (not 5432) in docker-compose.yml to avoid
# clashing with any Postgres already installed natively on your machine.
DATABASE_URL=postgresql+psycopg://F1 Lightning McQueen:F1 Lightning McQueen@localhost:5433/F1 Lightning McQueen

# OpenF1 is the only place in the system allowed to know this URL.
OPENF1_BASE_URL=https://api.openf1.org/v1
OPENF1_TIMEOUT_SECONDS=10
OPENF1_MAX_RETRIES=3
# Free tier limits, see https://openf1.org
OPENF1_MAX_REQUESTS_PER_SECOND=3
OPENF1_MAX_REQUESTS_PER_MINUTE=30

LOG_LEVEL=INFO

# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000
